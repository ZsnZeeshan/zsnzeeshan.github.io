#!/bin/sh

set -e

# Build the Jekyll site
bundle exec jekyll build

# Run NCA analytics event tests (Node + jsdom), the crawler/browser corpus
# coverage tests, and the end-to-end headless-browser test.
npm ci --silent
node test/nca-events.test.mjs
node test/bot-coverage.test.mjs
node test/bot-e2e.test.mjs
node test/source-regression.test.mjs

# Run HTML-Proofer
# Ignore the NCA script for SRI check since it has no provided integrity hash.
# Ignore transient 503s from GitHub (it rate-limits automated link checkers).
# Let Typhoeus follow redirects and allow 30s per request so slow-but-live
# sites (e.g. www.siliconpk.com -> siliconpk.com) don't fail the build.
# The 404 page's canonical URL always returns HTTP 404 by design, so ignore it.
 bundle exec htmlproofer ./_site --check-html --check-sri --http-status-ignore 503 --typhoeus-config '{"followlocation":true,"timeout":30}' --url-ignore 'https://nocookieanalytics.com/latest.js','/linkedin.com/','https://zsnzeeshan.github.io/404.html'

# Run RuboCop for code/style linting
bundle exec rubocop -D --config .rubocop.yml

# Optional: your custom HTML validation script
bundle exec script/validate-html

# Build the Slate gem
gem build jekyll-theme-slate.gemspec
